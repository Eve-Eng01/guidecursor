{
  "name": "@guidecursor/react",
  "version": "0.2.0",
  "description": "React bindings for guidecursor: provider, hook and an on-demand Guides menu.",
  "license": "MIT",
  "author": "Eve (https://github.com/Eve-Eng01)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eve-Eng01/guidecursor.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Eve-Eng01/guidecursor#readme",
  "bugs": {
    "url": "https://github.com/Eve-Eng01/guidecursor/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "product-tour",
    "walkthrough",
    "onboarding",
    "cursor",
    "guide"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@guidecursor/core": "0.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
