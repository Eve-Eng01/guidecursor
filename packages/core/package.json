{
  "name": "@guidecursor/core",
  "version": "0.2.0",
  "description": "Non-blocking, skippable product walkthroughs with an animated guide cursor. Framework-agnostic.",
  "license": "MIT",
  "author": "Eve (https://github.com/Eve-Eng01)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eve-Eng01/guidecursor.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Eve-Eng01/guidecursor#readme",
  "bugs": {
    "url": "https://github.com/Eve-Eng01/guidecursor/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "product-tour",
    "walkthrough",
    "onboarding",
    "tooltip",
    "cursor",
    "guide",
    "tour",
    "accessibility"
  ],
  "scripts": {
    "build": "tsup && node scripts/write-css.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=18"
  }
}
